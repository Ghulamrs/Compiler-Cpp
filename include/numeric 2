// <numeric> - the numeric algorithms, as much as has been asked for.
//
// accumulate is the one this exercise uses: a left fold over a range with a
// running total. Both forms - the default `+` and a caller's binary operation -
// are here, because [numeric.ops.accumulate] defines the first in terms of the
// second and a program may reach for either.
#ifndef _CXX1_NUMERIC
#define _CXX1_NUMERIC

namespace std {

template <class InputIt, class T>
T accumulate(InputIt first, InputIt last, T init) {
    for (; first != last; ++first) init = init + *first;
    return init;
}

template <class InputIt, class T, class BinaryOp>
T accumulate(InputIt first, InputIt last, T init, BinaryOp op) {
    for (; first != last; ++first) init = op(init, *first);
    return init;
}

}  // namespace std

#endif
