// <exception> - the base every thrown standard type derives from.
//
// **Separate from <stdexcept> because the standard separates them**, and the
// separation is not cosmetic: a program that catches `std::exception` without
// naming any of the concrete classes includes this one, and a header deriving
// from it needs only this one too. `<stdexcept>` includes it.
//
// What is NOT here is the rest of [exception]: `terminate`, `set_terminate`,
// `uncaught_exception`, `exception_ptr`, `current_exception`, `nested_exception`.
// The first three would be a runtime this compiler does not ship; the rest are
// C++11 machinery for moving an exception between threads, and there are no
// threads here. Named rather than silently absent.
//
// **`what()` is virtual and const, and returns a pointer the caller does not
// own.** [exception]/8 says the string is valid until the object is destroyed
// or a non-const member is called on it, which is what lets `<stdexcept>`
// return the address of a `std::string` member and nothing be copied.
#ifndef _CXX1_EXCEPTION
#define _CXX1_EXCEPTION

namespace std {

class exception {
public:
    exception() {}
    virtual ~exception() {}
    virtual const char *what() const { return "std::exception"; }
};

}  // namespace std

#endif
