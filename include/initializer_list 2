// <initializer_list> - the one library type the compiler builds itself.
//
// [support.initlist]: `std::initializer_list<T>` is a class the standard
// library declares and the *compiler* constructs - a brace-init-list `{a, b}`
// becomes a temporary array of the elements and an initializer_list referring
// to it. The class is ordinary; the magic is in how one is made, which is the
// compiler's business and not this file's.
//
// The layout is this file's, though, because the compiler builds an object of
// exactly it: a pointer to the first element and a count, in that order. Both
// begin() and size() read them back, so a range-for or an explicit
// begin()..end() walk sees what the braces held. Nothing here allocates or
// frees - the array the compiler makes outlives the list for the full
// expression, which is all [dcl.init.list]/6 promises.
#ifndef _CXX1_INITIALIZER_LIST
#define _CXX1_INITIALIZER_LIST

#include <cstddef>

namespace std {

template <class T>
class initializer_list {
public:
    typedef T           value_type;
    typedef const T&    reference;
    typedef const T&    const_reference;
    typedef size_t      size_type;
    typedef const T*    iterator;
    typedef const T*    const_iterator;

    // An empty list is the honest default: a null array and a zero count, which
    // begin() == end() reports as empty without a special case anywhere.
    initializer_list() : first_(0), count_(0) {}

    size_type size()  const { return count_; }
    const T*  begin() const { return first_; }
    const T*  end()   const { return first_ + count_; }

private:
    const T*  first_;
    size_type count_;
};

}  // namespace std

#endif
