#!/usr/bin/env python3
# The inventory behind docs/EXCLUSIONS.md, taken from the source rather than
# written by hand.
#
# A refusal here is a `src_.fail(...)` whose message says a construct is not
# implemented, or names a standard version. The messages are built from adjacent
# string literals with the offending name spliced in, so the literals are joined
# and a runtime piece becomes a <...> hole.
#
#   tools/exclusions                     the inventory, file:line and message
#   tools/exclusions --count             how many sites and distinct messages
#   tools/exclusions --check FILE        what the source refuses and FILE omits
#
# `--check docs/EXCLUSIONS.md` is the point of the tool: it is what stops that
# document becoming the hand-written list it was written to replace. It reads
# the file:line references out of the document and reports every refusal site
# the document does not cite, and every citation that no longer exists.
#
# Two things it cannot do, both recorded because a reader will meet them.
# A message written as a ternary comes back with both arms joined -- there are
# two, at ParserType.cpp's `explicit` and ParserTemplate.cpp's class/function
# template -- and no filter can tell a refusal from an ordinary diagnostic that
# happens to say "yet", so a handful of ordinary errors are listed and marked
# in the document rather than filtered here, where filtering them would be a
# judgement hidden in a script.

import os
import re
import sys

CALL = re.compile(r"\b(?:src_\.)?(?:fail|refuse|refuseTemplateId)\s*\(")
LIT = re.compile(r'"((?:[^"\\]|\\.)*)"')
# The two phrasings a refusal is written in, plus the bare "yet" that eleven of
# them use instead. `dynamic_cast`'s message carries only the third, which is
# why one grep does not find this list and this script exists.
MARK = re.compile(r"not supported|not implemented|is C\+\+1[0-9]|\byet\b", re.I)
SRC = re.compile(r"\.(cpp|h)$")


def call_text(lines, i):
    depth, out = 0, []
    for j in range(i, min(i + 14, len(lines))):
        out.append(lines[j])
        depth += lines[j].count("(") - lines[j].count(")")
        if depth <= 0 and "(" in "".join(out):
            break
    return "".join(out)


def message(text):
    body = text[text.index("(") + 1:]
    parts, pos, hole = [], 0, False
    for m in LIT.finditer(body):
        if pos and re.search(r"[A-Za-z_)\]]\s*\+", body[pos:m.start()] + " "):
            hole = True
        if hole and parts:
            parts.append("<...>")
            hole = False
        parts.append(m.group(1))
        pos = m.end()
    if re.search(r"\+\s*[A-Za-z_][A-Za-z0-9_.:>()\[\]-]*\s*(\)|;)", body[pos:]):
        parts.append("<...>")
    return " ".join("".join(parts).replace('\\"', "'").replace("\\n", " ").split())


def inventory(root="src"):
    rows = []
    for dirpath, _, names in os.walk(root):
        for n in sorted(names):
            if not SRC.search(n):
                continue
            path = os.path.join(dirpath, n)
            lines = open(path, encoding="utf-8", errors="replace").readlines()
            for i, line in enumerate(lines):
                if not CALL.search(line):
                    continue
                text = call_text(lines, i)
                if not MARK.search(text):
                    continue
                msg = message(text)
                if msg and MARK.search(msg):
                    rows.append((f"{path}:{i + 1}", msg))
    return rows


def main():
    args = sys.argv[1:]
    rows = inventory()

    if args and args[0] == "--count":
        print(f"{len(rows)} refusal sites, {len(set(m for _, m in rows))} distinct messages")
        return 0

    if args and args[0] == "--check":
        if len(args) < 2:
            print("usage: tools/exclusions --check docs/EXCLUSIONS.md", file=sys.stderr)
            return 2
        doc = open(args[1], encoding="utf-8").read()
        cited = set(re.findall(r"[A-Za-z0-9_/]+\.(?:cpp|h):\d+", doc))
        have = set(site for site, _ in rows)
        missing = sorted(s for s in have if s.replace("src/", "") not in cited and s not in cited)
        stale = sorted(c for c in cited if not any(s.endswith(c) or s == c for s in have))
        for s in missing:
            print(f"not in the document: {s}  {dict(rows)[s]}")
        for c in stale:
            print(f"cited and gone:      {c}")
        print(f"\n{len(have)} sites, {len(missing)} uncited, {len(stale)} stale citations")
        return 1 if (missing or stale) else 0

    for site, msg in rows:
        print(f"{site}\t{msg}")
    return 0


sys.exit(main())
