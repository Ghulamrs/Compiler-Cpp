#!/usr/bin/env bash
#
# Build inside a memory cgroup, so a compile that runs away is killed by itself
# rather than by the kernel picking a victim - and on this box the kernel's
# victim would be mysqld or httpd.
#
# Not a precaution in the abstract. On 12 August an unbounded `dnf` on this
# 419 MiB instance drove it into swap until sshd could no longer fork, and it
# took a hypervisor power cycle to get back. A capped process dies alone.
#
#   ./build            build
#   ./build test       build and run the differential suite
#   ./build clean
#
# Falls back to a plain make where cgroup delegation is unavailable, and says
# so rather than pretending it was capped.

set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

CAP=300M

if systemd-run --user --scope -q -p MemoryMax=$CAP true 2>/dev/null; then
    exec systemd-run --user --scope -q -p MemoryMax=$CAP make "$@"
elif sudo -n true 2>/dev/null; then
    # --uid keeps the object files owned by the caller; a root-owned .o would
    # break the next unprivileged build.
    exec sudo systemd-run --scope -q -p MemoryMax=$CAP \
        --uid="$(id -u)" --gid="$(id -g)" make "$@"
else
    echo "warning: no cgroup cap available - building UNCAPPED" >&2
    exec make "$@"
fi
